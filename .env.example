# ─────────────────────────────────────────────────────────────────────────────
# AlcoaBase Environment Configuration
# Copy this file to .env and fill in the values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=alcoabase
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=alcoabase
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (S3-compatible object storage)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=alcoabase
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=alcoabase
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch (vectors + search)
# ─────────────────────────────────────────────────────────────────────────────
OPENSEARCH_PORT=9200

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Celery broker)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# vLLM / Model Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# AlcoaBase ships with two model profiles:
#
#   SMALL  – fast iteration on a single consumer GPU (24 GB VRAM).
#            Active by default below.
#   LARGE  – production quality on high-end hardware (≥80 GB VRAM).
#            Commented out; uncomment to switch.
#
# Swapping profiles only requires changing these env vars and downloading
# the new weights — no code or OpenSearch index changes needed (all models
# in a given role share the same embedding dimension / API contract).
# ─────────────────────────────────────────────────────────────────────────────

# Path to pre-downloaded model weights on the host (mounted as /models/ in container)
MODEL_WEIGHTS_PATH=./llm_models

# ── Chat / Generation LLM ──────────────────────────────────────────────────
# SMALL: Qwen3.6 35B MoE — only 3B active params, fits on 24 GB GPU (~8 GB)
MODEL_CHAT_NAME=Qwen/Qwen3.6-35B-A3B
MODEL_CHAT_PATH=/llm_models/qwen3.6-35b-a3b
MODEL_CHAT_MAX_GPU_MEMORY_GB=24
# LARGE (uncomment to upgrade):
# MODEL_CHAT_NAME=meta-llama/Llama-3.3-70B-Instruct
# MODEL_CHAT_PATH=/models/llama-3.3-70b-instruct
# MODEL_CHAT_MAX_GPU_MEMORY_GB=60

# ── Multilingual Embedding Model ───────────────────────────────────────────
# SMALL: Qwen3-Embedding 0.6B — 1024-dim output, same as e5-large-instruct
MODEL_EMBEDDING_NAME=Qwen/Qwen3-Embedding-0.6B
MODEL_EMBEDDING_PATH=/llm_models/qwen3-embedding-0.6b
MODEL_EMBEDDING_DIMENSION=1024
# LARGE (uncomment to upgrade):
# MODEL_EMBEDDING_NAME=Qwen/Qwen3-Embedding-8B
# MODEL_EMBEDDING_PATH=/models/qwen3-embedding-8b
# MODEL_EMBEDDING_DIMENSION=1024

# ── Vision / OCR Model (loaded on-demand for scanned PDFs) ─────────────────
# SMALL: Gemma 4 E4B — effective 4B vision+text, native OCR, fits on 24 GB
MODEL_OCR_NAME=google/gemma-4-E4B-it
MODEL_OCR_PATH=/llm_models/gemma-4-e4b-it
# LARGE (uncomment to upgrade):
# MODEL_OCR_NAME=Qwen/Qwen2.5-VL-72B-Instruct
# MODEL_OCR_PATH=/models/qwen2.5-vl-72b-instruct

# GPU Configuration
GPU_DEVICE_ID=0

# vLLM Instance URLs
VLLM_BASE_URL=http://localhost:8000
VLLM_EMBEDDING_URL=http://localhost:8001
VLLM_PORT=8000
VLLM_EMBEDDING_PORT=8001

# Model Manager Mode: "gpu" (production), "cpu" (CPU inference), "mock" (dev/test)
MODEL_MANAGER_MODE=mock

# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
SECRET_KEY=changeme_secret_key_generate_a_random_value

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (React/Vite)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# CSV Runner (Playwright validation)
# ─────────────────────────────────────────────────────────────────────────────
CSV_TEST_USER=csv_test_user
CSV_TEST_PASSWORD=changeme_csv_password

# ─────────────────────────────────────────────────────────────────────────────
# Multimodal Knowledge Base (Phase 4.4)
# ─────────────────────────────────────────────────────────────────────────────
# Enable visual content indexing (diagrams, flowcharts) during document processing
ENABLE_VISUAL_INDEXING=true

# Relevance boost factor for visual chunks in process-related RAG queries (1.0-3.0)
VISUAL_BOOST_FACTOR=1.5

# Maximum number of pages to scan for visual content per document
MAX_VISUAL_PAGES_PER_DOCUMENT=100

# Maximum video file size in bytes (default 2 GB)
VIDEO_MAX_FILE_SIZE_BYTES=2147483648

# Maximum frames to extract from a video for analysis
VIDEO_MAX_FRAMES=500

# Cosine similarity threshold for consolidating similar video frames into steps
FRAME_SIMILARITY_THRESHOLD=0.85

# Semantic similarity threshold for matching video steps to SOP steps
ALIGNMENT_MATCH_THRESHOLD=0.7

# Path to ffmpeg/ffprobe binaries (for video processing)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─────────────────────────────────────────────────────────────────────────────
# Agent Registry (Phase 5.1)
# ─────────────────────────────────────────────────────────────────────────────
# Directory containing agent YAML definitions (watched for hot-reload)
AGENTS_DIR=./agents/examples

# Directory containing predefined archetype YAML files
ARCHETYPES_DIR=./agents/archetypes

# Hot-reload: file watcher polls for changes (uses watchfiles package)
# Set to false to disable hot-reload and only load agents at startup
AGENT_HOT_RELOAD_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Multi-Agent Auditing (Phase 5.2)
# ─────────────────────────────────────────────────────────────────────────────
# Anomaly detection scan interval (Celery beat schedule, in minutes)
ANOMALY_SCAN_INTERVAL_MINUTES=15

# Compliance scorecard scoring window (days to look back for averaging)
COMPLIANCE_SCORING_WINDOW_DAYS=90

# Review agent task timeout (seconds) — max time for a single agent review
REVIEW_AGENT_TIMEOUT_SECONDS=1800

# Business hours for off-hours mutation detection (24h format, UTC)
BUSINESS_HOURS_START=6
BUSINESS_HOURS_END=22

# ─────────────────────────────────────────────────────────────────────────────
# AI-Enhanced Training Ecosystem (Phase 5.3)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for AI training operations (schedule generation, material
# generation, question generation, roleplay evaluation, gap recalculation)
CELERY_AI_QUEUE=ai_operations

# Skill gap recalculation interval (Celery beat, hours)
SKILL_GAP_RECALC_INTERVAL_HOURS=6

# Stale virtual audit session timeout (minutes) — sessions with no activity
# beyond this threshold are automatically marked as "abandoned"
ROLEPLAY_STALE_SESSION_MINUTES=60

# Semantic similarity threshold for fill-in-blank answer grading (0.0–1.0)
FILL_IN_BLANK_THRESHOLD=0.85

# LLM evaluation score threshold for scenario-based answer grading (0.0–1.0)
SCENARIO_BASED_THRESHOLD=0.70

# RAG similarity threshold for dynamic feedback paragraph selection (0.0–1.0)
FEEDBACK_SIMILARITY_THRESHOLD=0.75

# Quiz pass threshold (percentage of correct answers required)
QUIZ_PASS_THRESHOLD=0.80

# Virtual audit pass threshold (weighted session score required)
VIRTUAL_AUDIT_PASS_THRESHOLD=0.70

# Minimum turns required for a virtual audit to produce a pass/fail result
VIRTUAL_AUDIT_MIN_TURNS=3

# ─────────────────────────────────────────────────────────────────────────────
# AI Document Generator (Phase 5.4)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for document generation tasks (shared with training AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Template analysis task timeout (seconds)
TEMPLATE_ANALYSIS_TIMEOUT_SECONDS=120

# Document generation task timeout (seconds)
DOCUMENT_GENERATION_TIMEOUT_SECONDS=600

# Maximum output document size in bytes (50 MB)
DOCUMENT_GENERATION_MAX_OUTPUT_BYTES=52428800

# Maximum placeholders per template
DOCUMENT_GENERATION_MAX_PLACEHOLDERS=50

# Knowledge base minimum relevance score for retrieved chunks (0.0–1.0)
DOCUMENT_GENERATION_KB_MIN_RELEVANCE=0.3

# Maximum KB chunks per section
DOCUMENT_GENERATION_KB_MAX_CHUNKS=10

# Context window token limit before trimming (approximate)
DOCUMENT_GENERATION_MAX_CONTEXT_TOKENS=6000

# Maximum preceding section summary tokens
DOCUMENT_GENERATION_MAX_PRECEDING_TOKENS=1000

# Reference document excerpt max characters
DOCUMENT_GENERATION_REF_EXCERPT_MAX_CHARS=2000

# Cross-reference extraction limit per document
DOCUMENT_GENERATION_MAX_CROSS_REFS=500

# Job status polling interval for frontend (milliseconds)
DOCUMENT_GENERATION_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# AI-Driven Change Impact Analysis (Phase 5.5)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for impact analysis tasks (shared with training/generation AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Hard timeout for the full impact analysis pipeline (seconds)
IMPACT_ANALYSIS_TIMEOUT_SECONDS=600

# Timeout for dependency graph builds (seconds)
DEPENDENCY_GRAPH_BUILD_TIMEOUT_SECONDS=300

# Timeout for gap analysis between document pairs (seconds)
GAP_ANALYSIS_TIMEOUT_SECONDS=180

# Maximum affected items assessed per impact analysis job
IMPACT_ANALYSIS_MAX_CANDIDATES=50

# Staleness threshold: processing jobs older than this are considered stale
# and eligible for replacement by a new trigger (seconds)
IMPACT_ANALYSIS_STALENESS_THRESHOLD_SECONDS=600

# Minimum embedding similarity threshold for creating semantic dependency edges (0.0–1.0)
DEPENDENCY_GRAPH_SEMANTIC_THRESHOLD=0.5

# Maximum gap findings retained per gap analysis job (sorted by severity)
GAP_ANALYSIS_MAX_FINDINGS=100

# Job duration estimate: seconds per downstream dependency (used for progress estimation)
IMPACT_ANALYSIS_SECONDS_PER_DEPENDENCY=15

# Minimum estimated job duration (seconds)
IMPACT_ANALYSIS_MIN_DURATION_SECONDS=30

# Frontend polling interval for job status updates (milliseconds)
IMPACT_ANALYSIS_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# AI-Powered Traceability & Gap Discovery (Phase 5.6)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for traceability matrix generation (shared with other AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Hard timeout for the full traceability matrix generation pipeline (seconds)
TRACEABILITY_GENERATION_TIMEOUT_SECONDS=600

# Per-document extraction timeout for AI-powered requirement/test case extraction (seconds)
TRACEABILITY_EXTRACTION_TIMEOUT_SECONDS=120

# InferenceClient connection timeout for traceability operations (seconds)
TRACEABILITY_INFERENCE_TIMEOUT_SECONDS=30

# Maximum retries for retryable inference errors (HTTP 503/429)
TRACEABILITY_MAX_RETRIES=3

# Minimum semantic similarity threshold for creating traceability links (0.0–1.0)
TRACEABILITY_SEMANTIC_THRESHOLD=0.5

# Maximum source documents per matrix generation request
TRACEABILITY_MAX_SOURCE_DOCUMENTS=10

# Maximum target documents per matrix generation request
TRACEABILITY_MAX_TARGET_DOCUMENTS=20

# Job duration estimate: seconds per document (used for progress estimation)
TRACEABILITY_SECONDS_PER_DOCUMENT=30

# Minimum estimated job duration (seconds)
TRACEABILITY_MIN_DURATION_SECONDS=60

# Frontend polling interval for job status updates (milliseconds)
TRACEABILITY_POLL_INTERVAL_MS=5000

# Frontend polling timeout before displaying error (milliseconds, default 10 minutes)
TRACEABILITY_POLL_TIMEOUT_MS=600000

# ─────────────────────────────────────────────────────────────────────────────
# Admin Dashboard — RBAC (Phase 6.1)
# ─────────────────────────────────────────────────────────────────────────────
# Default roles provisioned per company: system_admin, doc_admin, it_admin, member, viewer
# These are created automatically during company setup and via the Alembic migration.

# Bcrypt cost factor for password hashing (higher = more secure but slower)
# Default is 12 rounds. Increase for production if hardware allows.
BCRYPT_ROUNDS=12

# Temporary password length (characters, generated via secrets.token_urlsafe)
# The actual output is base64url-encoded, so 12 bytes → 16 characters
TEMP_PASSWORD_BYTES=12

# ─────────────────────────────────────────────────────────────────────────────
# Electronic Signatures (PAdES)
# ─────────────────────────────────────────────────────────────────────────────
# Signature mode: "pades" (production, real crypto) or "hash" (dev/test, SHA-256 only)
SIGNATURE_MODE=hash

# Required when SIGNATURE_MODE=pades:
# SIGNATURE_KEY_PATH=/certs/signing-key.pem
# SIGNATURE_CERT_PATH=/certs/signing-cert-chain.pem
# SIGNATURE_KEY_PASSWORD=

# Optional: RFC 3161 Timestamp Authority for long-term validation
# SIGNATURE_TSA_URL=http://timestamp.digicert.com

# ─────────────────────────────────────────────────────────────────────────────
# Admin Dashboard — System Configuration (Phase 6.2)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the system configuration management features.
# Runtime configuration is stored in PostgreSQL and overrides .env defaults.
# Changes made via the Admin UI are persisted in the database with full audit trail.

# Default backup schedule (cron expression, 5-field format)
# This is the initial value seeded into the database on first migration.
# After that, changes are made via the Admin UI and stored in PostgreSQL.
BACKUP_SCHEDULE_CRON=0 2 * * *

# Default backup retention period (days, 1-365)
BACKUP_RETENTION_DAYS=30

# Health check polling interval (seconds, 10-300)
HEALTH_CHECK_INTERVAL_SECONDS=30

# Health check degraded threshold (seconds, 1-30)
# Services responding slower than this are classified as "degraded"
HEALTH_CHECK_DEGRADED_THRESHOLD_SECONDS=5

# Health check unreachable timeout (seconds, 5-60)
# Services not responding within this time are classified as "unreachable"
HEALTH_CHECK_UNREACHABLE_TIMEOUT_SECONDS=10

# Docker socket path (mounted read-only into the backend container)
# Required for service status monitoring and vLLM restart functionality
DOCKER_SOCKET_PATH=/var/run/docker.sock

# ─────────────────────────────────────────────────────────────────────────────
# Audit Trail Viewer (Phase 6.3)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the centralized audit trail viewer and PDF export.

# Async PDF export threshold: exports with more events than this are processed
# in the background via Celery. Exports at or below this threshold are synchronous.
AUDIT_EXPORT_ASYNC_THRESHOLD=10000

# Celery soft time limit for async PDF export tasks (seconds).
# Exports exceeding this duration are terminated and marked as failed.
AUDIT_EXPORT_TIMEOUT_SECONDS=300

# Presigned URL expiry for exported PDFs stored in MinIO (seconds).
# Default: 72 hours (259200 seconds). After this period, the PDF is no longer downloadable.
AUDIT_EXPORT_RETENTION_SECONDS=259200

# Frontend polling interval for async export status checks (milliseconds).
AUDIT_EXPORT_POLL_INTERVAL_MS=5000

# Default page size for audit trail event listing (1–200).
AUDIT_TRAIL_DEFAULT_PAGE_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────
# ALC Corporate Environment Setup (Phase 8.2)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the ALC corporate tenant seeding service.

# Default password for all ALC corporate seed user accounts.
# Change this immediately after initial setup in production environments.
ALC_SEED_DEFAULT_PASSWORD=AlcCorp2024!

# ─────────────────────────────────────────────────────────────────────────────
# AI Risk & Compliance Framework (Phase 8.1)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the AI risk governance layer that classifies AI
# operations into risk tiers and enforces tier-appropriate controls.

# HITL checkpoint expiry window (hours). Pending checkpoints not reviewed
# within this window are automatically marked as expired and their outputs
# invalidated. Default: 72 hours per GxP requirements.
RISK_FRAMEWORK_CHECKPOINT_EXPIRY_HOURS=72

# Celery beat interval for the checkpoint expiry scanner (minutes).
# The task is idempotent — running more frequently has no adverse effect.
RISK_FRAMEWORK_EXPIRY_SCAN_INTERVAL_MINUTES=15

# Control Gate pre-execution check performance warning threshold (milliseconds).
# If the pre-check exceeds this duration, a warning is logged but controls
# are NOT bypassed. Default: 500ms.
RISK_FRAMEWORK_GATE_CHECK_WARN_MS=500

# Low-tier rate limit: maximum AI operations per user per hour for Low-risk
# task types. Prevents automated misuse of low-risk endpoints.
RISK_FRAMEWORK_LOW_TIER_RATE_LIMIT=100

# Audit log retention periods (days). These are minimum retention periods
# aligned with GxP record retention requirements.
RISK_FRAMEWORK_HIGH_TIER_RETENTION_DAYS=2555
RISK_FRAMEWORK_MEDIUM_TIER_RETENTION_DAYS=1095
RISK_FRAMEWORK_LOW_TIER_RETENTION_DAYS=365

# Maximum characters for full audit depth input/output truncation.
# Prevents excessive storage for very large AI inputs/outputs.
RISK_FRAMEWORK_AUDIT_MAX_CHARS=50000

# ─────────────────────────────────────────────────────────────────────────────
# Literature Search Engine (Phase 9.1)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the external literature search gateway that connects
# to PubMed, Crossref, and arXiv. This is the first feature with controlled
# outbound network access.

# Master switch: enable/disable the literature gateway.
# When false, all /api/literature endpoints return HTTP 503.
ALC_LITERATURE_ENABLED=false

# AES-256-GCM master encryption key for API keys stored in the database.
# REQUIRED when ALC_LITERATURE_ENABLED=true. Generate with:
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# The application refuses to start if this is missing and literature is enabled.
ALC_LITERATURE_ENCRYPTION_KEY=

# Directory containing custom source adapter plugins (Python modules).
# The built-in adapters (pubmed, crossref, arxiv) are always available.
# Set to a path with additional .py adapter files for custom sources.
# ALC_LITERATURE_ADAPTER_DIR=/app/custom_adapters

# HTTP/HTTPS proxy for outbound literature API requests.
# Leave empty for direct connections. Can also be configured at runtime
# via the /api/literature/admin/proxy endpoint.
ALC_LITERATURE_PROXY_URL=
ALC_LITERATURE_PROXY_USER=
ALC_LITERATURE_PROXY_PASSWORD=

# Periodic health check interval for registered source adapters (seconds).
# Health checks classify sources as available (<5s), degraded (5-15s),
# or unreachable (>15s). Default: 300 (5 minutes).
ALC_LITERATURE_HEALTH_CHECK_INTERVAL_SECONDS=300

# TTL for async search task results stored in Redis (seconds).
# After this period, completed task results are automatically purged.
# Default: 3600 (1 hour).
ALC_LITERATURE_ASYNC_RESULT_TTL_SECONDS=3600

# ─────────────────────────────────────────────────────────────────────────────
# Automated Ingestion Pipeline (Phase 9.2)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the literature ingestion pipeline that retrieves
# full-text articles via Unpaywall, sanitizes them, and stores in MinIO.
# Requires ALC_LITERATURE_ENABLED=true (Phase 9.1 prerequisite).

# Unpaywall API base URL for DOI-to-open-access resolution.
ALC_UNPAYWALL_API_URL=https://api.unpaywall.org

# MinIO bucket name for literature file storage (original + sanitized content).
ALC_LITERATURE_BUCKET=alcoabase-literature

# Maximum allowed file size in MB for literature downloads.
# Downloads exceeding this limit are aborted before transfer.
ALC_LITERATURE_MAX_FILE_SIZE_MB=100

# Default retention period in days for downloaded original full-text files.
# After this period, original files are purged (sanitized content retained).
# Set to 0 for indefinite retention (no automatic cleanup).
ALC_LITERATURE_RETENTION_DAYS=365

# Default per-company storage quota in MB for literature files.
# Warning issued at 90%; new downloads rejected at 100%.
ALC_LITERATURE_STORAGE_QUOTA_MB=10240

# Celery queue name for all ingestion pipeline tasks.
# Separate from the literature_search queue used by Phase 9.1.
ALC_LITERATURE_QUEUE_NAME=literature_ingestion

# Cron expression for the retention cleanup periodic task.
# Default: daily at 02:00 UTC. Processes up to 100 expired files per run.
ALC_LITERATURE_CLEANUP_CRON=0 2 * * *

# User-Agent header value for outbound HTTP requests to Unpaywall and
# publisher download endpoints. Should identify your installation.
ALC_LITERATURE_USER_AGENT=AlcoaBase/1.0 (Literature Ingestion)

# ─────────────────────────────────────────────────────────────────────────────
# High-Dimensional Embedding & Hybrid Search (Phase 9.3)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the embedding generation pipeline, OpenSearch index
# structure, and hybrid search engine for literature embeddings.
# Requires Phase 9.1 + 9.2 prerequisites (ALC_LITERATURE_ENABLED=true).

# OpenSearch index settings for literature embedding indices.
# Each company gets its own index: literature-embeddings-{company_id}.
ALC_LITERATURE_INDEX_SHARDS=1
ALC_LITERATURE_INDEX_REPLICAS=1

# HNSW (Hierarchical Navigable Small World) parameters for kNN vector search.
# Higher ef_construction = better recall but slower index builds.
# Higher m = better recall but more memory per node.
ALC_LITERATURE_HNSW_EF_CONSTRUCTION=256
ALC_LITERATURE_HNSW_M=16

# Default reciprocal rank fusion (RRF) constant for hybrid search.
# Controls how BM25 and kNN ranked lists are merged.
# Lower k = more weight to top-ranked documents; higher k = smoother blending.
ALC_LITERATURE_RRF_K=60

# Celery queue name for embedding generation and re-indexing tasks.
# Uses the same queue as ingestion tasks by default.
ALC_LITERATURE_EMBEDDING_QUEUE=literature_ingestion

# Number of records processed per batch during re-indexing operations (10–200).
# Larger batches = faster re-indexing but more memory/vLLM load per batch.
ALC_REINDEX_BATCH_SIZE=50

# ─────────────────────────────────────────────────────────────────────────────
# Literature Review & Synthesis Agents (Phase 9.4)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the AI-powered systematic literature review pipeline
# and contradiction detection service. Requires Phase 9.1–9.3 prerequisites.

# Celery queue for literature screening batch tasks.
# Uses the shared ai_operations queue by default.
ALC_LITERATURE_SCREENING_QUEUE=ai_operations

# Celery queue for contradiction detection cross-reference tasks.
ALC_LITERATURE_CONTRADICTION_QUEUE=ai_operations

# Minimum cosine similarity threshold for matching internal documents
# during contradiction detection. Documents below this threshold are
# not considered as potential contradictions. Range: 0.0–1.0.
ALC_CONTRADICTION_SIMILARITY_THRESHOLD=0.6

# Maximum number of internal document candidates to retrieve and analyze
# for each newly indexed paper. Range: 1–50.
ALC_CONTRADICTION_MAX_CANDIDATES=10

# Minimum confidence score from the LLM contradiction analysis to create
# a Contradiction Alert. Results below this threshold are noted but not
# persisted as alerts. Range: 0.0–1.0.
ALC_CONTRADICTION_CONFIDENCE_THRESHOLD=0.7

# Soft time limit in seconds for screening Celery tasks.
# Tasks exceeding this limit are terminated and retried with exponential backoff.
# Range: 60–7200 (1 minute to 2 hours).
ALC_SCREENING_TASK_TIMEOUT=1800

# Maximum number of concurrent screening tasks per company.
# Prevents overwhelming the vLLM instance with too many parallel requests.
# Range: 1–20.
ALC_SCREENING_MAX_CONCURRENT=5

# ─────────────────────────────────────────────────────────────────────────────
# Medical Device Vigilance & Post-Market Surveillance (Phase 9.5)
# ─────────────────────────────────────────────────────────────────────────────
# These settings control the continuous vigilance monitoring system for medical
# device companies. Requires Phase 9.1–9.4 prerequisites.

# Celery queue name for vigilance search execution tasks.
# Uses the literature_ingestion queue by default for consistent prioritization.
ALC_VIGILANCE_SEARCH_QUEUE=literature_ingestion

# Celery queue name for signal detection (LLM analysis) tasks.
# Uses the ai_operations queue by default (shared with Phase 9.4 screening).
ALC_VIGILANCE_SIGNAL_QUEUE=ai_operations

# Minimum confidence threshold for creating a VigilanceSignal record.
# Signals with confidence below this value are recorded as "no_signal" without
# creating a formal signal for human review. Range: 0.1–1.0.
# Lower values increase sensitivity (more signals, more false positives).
# Higher values increase specificity (fewer signals, risk of missed events).
ALC_VIGILANCE_SIGNAL_CONFIDENCE_THRESHOLD=0.7

# Maximum concurrent signal detection tasks per company.
# Prevents overwhelming the vLLM instance with parallel vigilance analysis.
# Range: 1–50.
ALC_VIGILANCE_MAX_CONCURRENT_DETECTIONS=5

# Vigilance search execution timeout in seconds.
# Executions exceeding this duration are marked as "partial_failure".
# Minimum: 300 seconds (5 minutes). Default: 3600 (60 minutes).
ALC_VIGILANCE_SEARCH_TIMEOUT=3600

# Number of ingestion records per signal detection batch.
# Larger batches improve throughput but increase per-batch latency.
# Range: 1–50.
ALC_VIGILANCE_SIGNAL_BATCH_SIZE=10

# Maximum retry attempts for escalation notification delivery.
# Each retry uses a 5-minute fixed interval. Range: 1–10.
ALC_VIGILANCE_ESCALATION_RETRIES=3

# Enable automatic periodic safety report generation.
# When true, reports are generated on the schedule configured per product.
# When false, reports can still be generated manually via the API.
ALC_VIGILANCE_AUTO_REPORT_ENABLED=true
