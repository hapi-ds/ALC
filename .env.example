# ─────────────────────────────────────────────────────────────────────────────
# AlcoaBase Environment Configuration
# Copy this file to .env and fill in the values before running docker compose.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=alcoabase
POSTGRES_PASSWORD=changeme_postgres
POSTGRES_DB=alcoabase
POSTGRES_PORT=5432

# ─────────────────────────────────────────────────────────────────────────────
# MinIO (S3-compatible object storage)
# ─────────────────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=alcoabase
MINIO_ROOT_PASSWORD=changeme_minio
MINIO_BUCKET=alcoabase
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─────────────────────────────────────────────────────────────────────────────
# OpenSearch (vectors + search)
# ─────────────────────────────────────────────────────────────────────────────
OPENSEARCH_PORT=9200

# ─────────────────────────────────────────────────────────────────────────────
# Redis (Celery broker)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# vLLM / Model Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# AlcoaBase ships with two model profiles:
#
#   SMALL  – fast iteration on a single consumer GPU (24 GB VRAM).
#            Active by default below.
#   LARGE  – production quality on high-end hardware (≥80 GB VRAM).
#            Commented out; uncomment to switch.
#
# Swapping profiles only requires changing these env vars and downloading
# the new weights — no code or OpenSearch index changes needed (all models
# in a given role share the same embedding dimension / API contract).
# ─────────────────────────────────────────────────────────────────────────────

# Path to pre-downloaded model weights on the host (mounted as /models/ in container)
MODEL_WEIGHTS_PATH=./models

# ── Chat / Generation LLM ──────────────────────────────────────────────────
# SMALL: Qwen3.6 35B MoE — only 3B active params, fits on 24 GB GPU (~8 GB)
MODEL_CHAT_NAME=Qwen/Qwen3.6-35B-A3B
MODEL_CHAT_PATH=/models/qwen3.6-35b-a3b
MODEL_CHAT_MAX_GPU_MEMORY_GB=24
# LARGE (uncomment to upgrade):
# MODEL_CHAT_NAME=meta-llama/Llama-3.3-70B-Instruct
# MODEL_CHAT_PATH=/models/llama-3.3-70b-instruct
# MODEL_CHAT_MAX_GPU_MEMORY_GB=60

# ── Multilingual Embedding Model ───────────────────────────────────────────
# SMALL: Qwen3-Embedding 0.6B — 1024-dim output, same as e5-large-instruct
MODEL_EMBEDDING_NAME=Qwen/Qwen3-Embedding-0.6B
MODEL_EMBEDDING_PATH=/models/qwen3-embedding-0.6b
MODEL_EMBEDDING_DIMENSION=1024
# LARGE (uncomment to upgrade):
# MODEL_EMBEDDING_NAME=Qwen/Qwen3-Embedding-8B
# MODEL_EMBEDDING_PATH=/models/qwen3-embedding-8b
# MODEL_EMBEDDING_DIMENSION=1024

# ── Vision / OCR Model (loaded on-demand for scanned PDFs) ─────────────────
# SMALL: Gemma 4 E4B — effective 4B vision+text, native OCR, fits on 24 GB
MODEL_OCR_NAME=google/gemma-4-E4B-it
MODEL_OCR_PATH=/models/gemma-4-e4b-it
# LARGE (uncomment to upgrade):
# MODEL_OCR_NAME=Qwen/Qwen2.5-VL-72B-Instruct
# MODEL_OCR_PATH=/models/qwen2.5-vl-72b-instruct

# GPU Configuration
GPU_DEVICE_ID=0

# vLLM Instance URLs
VLLM_BASE_URL=http://localhost:8000
VLLM_EMBEDDING_URL=http://localhost:8001
VLLM_PORT=8000
VLLM_EMBEDDING_PORT=8001

# Model Manager Mode: "gpu" (production), "cpu" (CPU inference), "mock" (dev/test)
MODEL_MANAGER_MODE=mock

# ─────────────────────────────────────────────────────────────────────────────
# Backend (FastAPI)
# ─────────────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
SECRET_KEY=changeme_secret_key_generate_a_random_value

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (React/Vite)
# ─────────────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# CSV Runner (Playwright validation)
# ─────────────────────────────────────────────────────────────────────────────
CSV_TEST_USER=csv_test_user
CSV_TEST_PASSWORD=changeme_csv_password

# ─────────────────────────────────────────────────────────────────────────────
# Multimodal Knowledge Base (Phase 4.4)
# ─────────────────────────────────────────────────────────────────────────────
# Enable visual content indexing (diagrams, flowcharts) during document processing
ENABLE_VISUAL_INDEXING=true

# Relevance boost factor for visual chunks in process-related RAG queries (1.0-3.0)
VISUAL_BOOST_FACTOR=1.5

# Maximum number of pages to scan for visual content per document
MAX_VISUAL_PAGES_PER_DOCUMENT=100

# Maximum video file size in bytes (default 2 GB)
VIDEO_MAX_FILE_SIZE_BYTES=2147483648

# Maximum frames to extract from a video for analysis
VIDEO_MAX_FRAMES=500

# Cosine similarity threshold for consolidating similar video frames into steps
FRAME_SIMILARITY_THRESHOLD=0.85

# Semantic similarity threshold for matching video steps to SOP steps
ALIGNMENT_MATCH_THRESHOLD=0.7

# Path to ffmpeg/ffprobe binaries (for video processing)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ─────────────────────────────────────────────────────────────────────────────
# Agent Registry (Phase 5.1)
# ─────────────────────────────────────────────────────────────────────────────
# Directory containing agent YAML definitions (watched for hot-reload)
AGENTS_DIR=./agents/examples

# Directory containing predefined archetype YAML files
ARCHETYPES_DIR=./agents/archetypes

# Hot-reload: file watcher polls for changes (uses watchfiles package)
# Set to false to disable hot-reload and only load agents at startup
AGENT_HOT_RELOAD_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# Multi-Agent Auditing (Phase 5.2)
# ─────────────────────────────────────────────────────────────────────────────
# Anomaly detection scan interval (Celery beat schedule, in minutes)
ANOMALY_SCAN_INTERVAL_MINUTES=15

# Compliance scorecard scoring window (days to look back for averaging)
COMPLIANCE_SCORING_WINDOW_DAYS=90

# Review agent task timeout (seconds) — max time for a single agent review
REVIEW_AGENT_TIMEOUT_SECONDS=1800

# Business hours for off-hours mutation detection (24h format, UTC)
BUSINESS_HOURS_START=6
BUSINESS_HOURS_END=22

# ─────────────────────────────────────────────────────────────────────────────
# AI-Enhanced Training Ecosystem (Phase 5.3)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for AI training operations (schedule generation, material
# generation, question generation, roleplay evaluation, gap recalculation)
CELERY_AI_QUEUE=ai_operations

# Skill gap recalculation interval (Celery beat, hours)
SKILL_GAP_RECALC_INTERVAL_HOURS=6

# Stale virtual audit session timeout (minutes) — sessions with no activity
# beyond this threshold are automatically marked as "abandoned"
ROLEPLAY_STALE_SESSION_MINUTES=60

# Semantic similarity threshold for fill-in-blank answer grading (0.0–1.0)
FILL_IN_BLANK_THRESHOLD=0.85

# LLM evaluation score threshold for scenario-based answer grading (0.0–1.0)
SCENARIO_BASED_THRESHOLD=0.70

# RAG similarity threshold for dynamic feedback paragraph selection (0.0–1.0)
FEEDBACK_SIMILARITY_THRESHOLD=0.75

# Quiz pass threshold (percentage of correct answers required)
QUIZ_PASS_THRESHOLD=0.80

# Virtual audit pass threshold (weighted session score required)
VIRTUAL_AUDIT_PASS_THRESHOLD=0.70

# Minimum turns required for a virtual audit to produce a pass/fail result
VIRTUAL_AUDIT_MIN_TURNS=3

# ─────────────────────────────────────────────────────────────────────────────
# AI Document Generator (Phase 5.4)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for document generation tasks (shared with training AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Template analysis task timeout (seconds)
TEMPLATE_ANALYSIS_TIMEOUT_SECONDS=120

# Document generation task timeout (seconds)
DOCUMENT_GENERATION_TIMEOUT_SECONDS=600

# Maximum output document size in bytes (50 MB)
DOCUMENT_GENERATION_MAX_OUTPUT_BYTES=52428800

# Maximum placeholders per template
DOCUMENT_GENERATION_MAX_PLACEHOLDERS=50

# Knowledge base minimum relevance score for retrieved chunks (0.0–1.0)
DOCUMENT_GENERATION_KB_MIN_RELEVANCE=0.3

# Maximum KB chunks per section
DOCUMENT_GENERATION_KB_MAX_CHUNKS=10

# Context window token limit before trimming (approximate)
DOCUMENT_GENERATION_MAX_CONTEXT_TOKENS=6000

# Maximum preceding section summary tokens
DOCUMENT_GENERATION_MAX_PRECEDING_TOKENS=1000

# Reference document excerpt max characters
DOCUMENT_GENERATION_REF_EXCERPT_MAX_CHARS=2000

# Cross-reference extraction limit per document
DOCUMENT_GENERATION_MAX_CROSS_REFS=500

# Job status polling interval for frontend (milliseconds)
DOCUMENT_GENERATION_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# AI-Driven Change Impact Analysis (Phase 5.5)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for impact analysis tasks (shared with training/generation AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Hard timeout for the full impact analysis pipeline (seconds)
IMPACT_ANALYSIS_TIMEOUT_SECONDS=600

# Timeout for dependency graph builds (seconds)
DEPENDENCY_GRAPH_BUILD_TIMEOUT_SECONDS=300

# Timeout for gap analysis between document pairs (seconds)
GAP_ANALYSIS_TIMEOUT_SECONDS=180

# Maximum affected items assessed per impact analysis job
IMPACT_ANALYSIS_MAX_CANDIDATES=50

# Staleness threshold: processing jobs older than this are considered stale
# and eligible for replacement by a new trigger (seconds)
IMPACT_ANALYSIS_STALENESS_THRESHOLD_SECONDS=600

# Minimum embedding similarity threshold for creating semantic dependency edges (0.0–1.0)
DEPENDENCY_GRAPH_SEMANTIC_THRESHOLD=0.5

# Maximum gap findings retained per gap analysis job (sorted by severity)
GAP_ANALYSIS_MAX_FINDINGS=100

# Job duration estimate: seconds per downstream dependency (used for progress estimation)
IMPACT_ANALYSIS_SECONDS_PER_DEPENDENCY=15

# Minimum estimated job duration (seconds)
IMPACT_ANALYSIS_MIN_DURATION_SECONDS=30

# Frontend polling interval for job status updates (milliseconds)
IMPACT_ANALYSIS_POLL_INTERVAL_MS=5000

# ─────────────────────────────────────────────────────────────────────────────
# AI-Powered Traceability & Gap Discovery (Phase 5.6)
# ─────────────────────────────────────────────────────────────────────────────
# Celery queue for traceability matrix generation (shared with other AI ops)
# CELERY_AI_QUEUE=ai_operations  (already defined in Phase 5.3 above)

# Hard timeout for the full traceability matrix generation pipeline (seconds)
TRACEABILITY_GENERATION_TIMEOUT_SECONDS=600

# Per-document extraction timeout for AI-powered requirement/test case extraction (seconds)
TRACEABILITY_EXTRACTION_TIMEOUT_SECONDS=120

# InferenceClient connection timeout for traceability operations (seconds)
TRACEABILITY_INFERENCE_TIMEOUT_SECONDS=30

# Maximum retries for retryable inference errors (HTTP 503/429)
TRACEABILITY_MAX_RETRIES=3

# Minimum semantic similarity threshold for creating traceability links (0.0–1.0)
TRACEABILITY_SEMANTIC_THRESHOLD=0.5

# Maximum source documents per matrix generation request
TRACEABILITY_MAX_SOURCE_DOCUMENTS=10

# Maximum target documents per matrix generation request
TRACEABILITY_MAX_TARGET_DOCUMENTS=20

# Job duration estimate: seconds per document (used for progress estimation)
TRACEABILITY_SECONDS_PER_DOCUMENT=30

# Minimum estimated job duration (seconds)
TRACEABILITY_MIN_DURATION_SECONDS=60

# Frontend polling interval for job status updates (milliseconds)
TRACEABILITY_POLL_INTERVAL_MS=5000

# Frontend polling timeout before displaying error (milliseconds, default 10 minutes)
TRACEABILITY_POLL_TIMEOUT_MS=600000

# ─────────────────────────────────────────────────────────────────────────────
# Electronic Signatures (PAdES)
# ─────────────────────────────────────────────────────────────────────────────
# Signature mode: "pades" (production, real crypto) or "hash" (dev/test, SHA-256 only)
SIGNATURE_MODE=hash

# Required when SIGNATURE_MODE=pades:
# SIGNATURE_KEY_PATH=/certs/signing-key.pem
# SIGNATURE_CERT_PATH=/certs/signing-cert-chain.pem
# SIGNATURE_KEY_PASSWORD=

# Optional: RFC 3161 Timestamp Authority for long-term validation
# SIGNATURE_TSA_URL=http://timestamp.digicert.com
